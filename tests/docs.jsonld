    {
      "@id": "#TournamentCreditsReview",
      "@type": "Class",
      "title": "TournamentCreditsReview",
      "supportedProperty": [
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentCreditsReview/tournament",
            "@type": "rdf:Property",
            "domain": "#TournamentCreditsReview",
            "label": "tournament",
            "range": "xsd:integer"
          },
          "title": "tournament",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "ID турнира: часть адреса, не поле ответа."
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentCreditsReview/parse",
            "@type": "rdf:Property",
            "domain": "#TournamentCreditsReview",
            "label": "parse"
          },
          "title": "parse",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Последний разбор файла турнира: status (pending, ready, failed, not_packet), fileName, createdAt, error («не удалось прочитать пакет» у упавшего); null — разборов не было"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentCreditsReview/sourceFile",
            "@type": "rdf:Property",
            "domain": "#TournamentCreditsReview",
            "label": "sourceFile",
            "range": "xsd:string"
          },
          "title": "sourceFile",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Файл, из которого взяты титры; null — титров из файла нет"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentCreditsReview/review",
            "@type": "rdf:Property",
            "domain": "#TournamentCreditsReview",
            "label": "review"
          },
          "title": "review",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Имена, которые ждут проверки: role, written (как в пакете), key (ключ решения), ranges ([первый, последний] вопрос), candidates (до 20 тёзок: id, name, games, town), suggested (id тёзок, засчитанных под вопросом)"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentCreditsReview/credits",
            "@type": "rdf:Property",
            "domain": "#TournamentCreditsReview",
            "label": "credits"
          },
          "title": "credits",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Засчитанные титры: role, player {id, name}, ranges, tentative (под вопросом), source (packet или manual), key (ключ решения у титра из пакета), manualIds (id ручных титров)"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentCreditsReview/questions",
            "@type": "rdf:Property",
            "domain": "#TournamentCreditsReview",
            "label": "questions",
            "range": "xsd:integer"
          },
          "title": "questions",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Число вопросов турнира"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentCreditsReview/frozen",
            "@type": "rdf:Property",
            "domain": "#TournamentCreditsReview",
            "label": "frozen"
          },
          "title": "frozen",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Заморозка: by (кто), at (когда, ISO 8601); null — титры не заморожены"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentCreditsReview/manualText",
            "@type": "rdf:Property",
            "domain": "#TournamentCreditsReview",
            "label": "manualText",
            "range": "xsd:string"
          },
          "title": "manualText",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Текст титров, внесённый вручную; null — его нет"
        }
      ],
      "supportedOperation": [
        {
          "@type": [
            "Operation",
            "schema:FindAction"
          ],
          "description": "Retrieves a TournamentCreditsReview resource.",
          "method": "GET",
          "returns": "TournamentCreditsReview",
          "title": "getTournamentCreditsReview"
        },
        {
          "@type": [
            "Operation",
            "schema:DeleteAction"
          ],
          "description": "Deletes the TournamentCreditsReview resource.",
          "method": "DELETE",
          "returns": "owl:Nothing",
          "title": "deleteTournamentCreditsReview"
        }
      ],
      "description": "Проверка «Редакторов и тестеров» турнира: что распознано в пакете и что решили проверяющие"
    },
