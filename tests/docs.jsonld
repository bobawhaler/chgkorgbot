          "writeable": false
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#SynchTournament/formattedAllPayments",
            "@type": "rdf:Property",
            "domain": "#SynchTournament",
            "label": "formattedAllPayments"
          },
          "title": "formattedAllPayments",
          "required": false,
          "readable": true,
          "writeable": false
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#SynchTournament/formattedAllPaymentsArray",
            "@type": "rdf:Property",
            "domain": "#SynchTournament",
            "label": "formattedAllPaymentsArray"
          },
          "title": "formattedAllPaymentsArray",
          "required": false,
          "readable": true,
          "writeable": false,
          "description": "Категории взносов для показа: название → суммы. «По умолчанию» первой,\nдоплаты последними и со знаком «+» («допвзнос за отбор на ЧР — +р600»):\nони прибавляются к взносу, а не заменяют его."
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#SynchTournament/paymentSurchargeReasons",
            "@type": "rdf:Property",
            "domain": "#SynchTournament",
            "label": "paymentSurchargeReasons",
            "range": "xsd:string"
          },
          "title": "paymentSurchargeReasons",
          "required": false,
          "readable": true,
          "writeable": false,
          "description": "Названия категорий-доплат (страница «оплата» показывает их отдельно от\nльготных категорий)."
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#SynchTournament/credits",
            "@type": "rdf:Property",
            "domain": "#SynchTournament",
            "label": "credits"
          },
          "title": "credits",
          "required": false,
          "readable": true,
          "writeable": false,
          "description": "Редакторы, тестеры и авторы вопросов по пакету турнира, как в блоке «Редакторы и тестеры» на сайте. Первая запись с tour и questions, равными null, — редакторы всего пакета (редакторы турнира, которых пакет не называет, есть только в поле editors); дальше — группы вопросов подряд с одними и теми же редакторами и тестерами: tour — номер тура пакета (null — вне туров), questions — номера первого и последнего вопроса. Человек — игрок (player); тёзки, из которых не выбран ни один, — одна запись players со всеми кандидатами и tentative: true; если игрок не найден — имя, как в пакете (name). Только в ответе /tournaments/{id}."
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#SynchTournament/teamsCount",
            "@type": "rdf:Property",
            "domain": "#SynchTournament",
            "label": "teamsCount",
            "range": "xsd:integer"
          },
          "title": "teamsCount",
          "required": false,
          "readable": true,
          "writeable": false,
          "description": "Количество команд, сыгравших турнир (как «Количество команд» на странице турнира)"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#SynchTournament/expectedTeams",
            "@type": "rdf:Property",
            "domain": "#SynchTournament",
            "label": "expectedTeams",
            "range": "xsd:integer"
          },
          "title": "expectedTeams",
          "required": false,
          "readable": true,
          "writeable": false,
          "description": "Прогноз числа команд, как «Команд» на странице «Синхроны»: по одобренным заявкам — ожидаемое число команд площадки, у площадок, внёсших результаты, — сколько команд сыграло. Нет поля — одобренных заявок нет"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#SynchTournament/siteUrl",
