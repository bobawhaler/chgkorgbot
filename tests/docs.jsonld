    {
      "@id": "#Results",
      "@type": "Class",
      "title": "Results",
      "supportedProperty": [
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Results/team",
            "@type": "Link",
            "domain": "#Results",
            "label": "team",
            "owl:maxCardinality": 1,
            "range": "#Team"
          },
          "title": "team",
          "required": false,
          "readable": true,
          "writeable": true
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Results/mask",
            "@type": "rdf:Property",
            "domain": "#Results",
            "label": "mask",
            "range": "xsd:string"
          },
          "title": "mask",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "\n        Расплюсовка команды. Каждый символ соответствует вопросу.\n        0 - вопрос не взят,\n        1 - вопрос взят,\n        ? - подан и ещё не рассмотрен спорный,\n        X (латинская) - вопрос снят.\n        \n        В случае, если расплюсовки нет, возвращает null\n    "
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Results/id",
            "@type": "rdf:Property",
            "domain": "#Results",
            "label": "id",
            "range": "xsd:integer"
          },
          "title": "id",
          "required": false,
          "readable": true,
          "writeable": true
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Results/current",
            "@type": "rdf:Property",
            "domain": "#Results",
            "label": "current",
            "owl:maxCardinality": 1,
            "range": "#Current"
          },
          "title": "current",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Текущее название команды"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Results/questionsTotal",
            "@type": "rdf:Property",
            "domain": "#Results",
            "label": "questionsTotal",
            "range": "xsd:integer"
          },
          "title": "questionsTotal",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Количество взятых командой вопросов. Если у команды уже зачтены какие-либо спорные и апелляции - здесь они учитываются."
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Results/resultsAvailable",
            "@type": "rdf:Property",
            "domain": "#Results",
            "label": "resultsAvailable",
            "range": "xsd:boolean"
          },
          "title": "resultsAvailable",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Загружены ли результаты команды. Отдаётся и тогда, когда результаты турнира скрыты до tournament.hideResultsTo: сами questionsTotal и position в этом случае приходят как null. До отыгрыша всегда false: у (а)синхрона — до synchRequest.dateStart + 6 часов, у остальных турниров — до tournament.dateEnd. Также false, пока ни одна команда той же заявки (у команды без заявки — ни одна команда турнира) не взяла ни одного вопроса: такой ноль неотличим от пустой сетки."
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Results/synchRequest",
            "@type": "rdf:Property",
            "domain": "#Results",
            "label": "synchRequest",
            "owl:maxCardinality": 1,
            "range": "#TournamentSynchRequest"
          },
          "title": "synchRequest",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Заявка на синхрон. В случае, если турнир не является (а)синхроном, это поле возвращает null."
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Results/rating",
            "@type": "rdf:Property",
            "domain": "#Results",
            "label": "rating",
            "owl:maxCardinality": 1,
            "range": "#TournamentPositionsBalanced"
          },
          "title": "rating",
          "required": false,
          "readable": true,
          "writeable": true
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Results/position",
            "@type": "rdf:Property",
            "domain": "#Results",
            "label": "position",
            "range": "xsd:decimal"
          },
          "title": "position",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Позиция команды на турнире. Если делится - отображается среднее арифметическое поделённых мест."
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Results/controversials",
            "@type": "rdf:Property",
            "domain": "#Results",
            "label": "controversials",
            "range": "#TournamentSynchControversial"
          },
          "title": "controversials",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Спорные, поданные командой"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Results/flags",
            "@type": "Link",
            "domain": "#Results",
            "label": "flags",
            "range": "#TournamentTeamFlag"
          },
          "title": "flags",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Флаги (зачёты) команды на турнире"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Results/teamMembers",
            "@type": "rdf:Property",
            "domain": "#Results",
            "label": "teamMembers",
            "range": "#TeamMember"
          },
          "title": "teamMembers",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Состав команды на турнире"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Results/tiebreaker",
            "@type": "rdf:Property",
            "domain": "#Results",
            "label": "tiebreaker",
            "range": "xsd:string"
          },
          "title": "tiebreaker",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "Перестрелка команды, как на повопросной странице турнира на сайте (туры): 1 — вопрос взят, 0 — не взят, раунды перестрелки через пробел, например \"101 11\" (как в POST /tournaments/{id}/tiebreakers). null — команда не стрелялась. Приходит вместе с mask (includeMasksAndControversials) и тогда же открывается."
        }
      ],
      "supportedOperation": [
        {
          "@type": [
            "Operation",
            "schema:FindAction"
          ],
          "description": "Retrieves a Results resource.",
          "method": "GET",
          "returns": "owl:Nothing",
          "title": "getResults"
        }
      ]
