            "range": "xsd:decimal"
          },
          "title": "predictedPosition",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "прогнозное место команды"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentPositionsBalanced/rt",
            "@type": "rdf:Property",
            "domain": "#TournamentPositionsBalanced",
            "label": "rt",
            "range": "xsd:integer"
          },
          "title": "rt",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "технический рейтинг команды (умноженная на Q сумма рейтингов шести наиболее высокорейтинговых игроков с\nкоэффициентами 1, 5/6, ..., 1/6)"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentPositionsBalanced/rb",
            "@type": "rdf:Property",
            "domain": "#TournamentPositionsBalanced",
            "label": "rb",
            "range": "xsd:integer"
          },
          "title": "rb",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "технический рейтинг по базовому составу"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentPositionsBalanced/rg",
            "@type": "rdf:Property",
            "domain": "#TournamentPositionsBalanced",
            "label": "rg",
            "range": "xsd:integer"
          },
          "title": "rg",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "турнирный рейтинг команды (для беспреемственных, сборных и команд с нулевым рейтингом равен техническому\nрейтингу RG=RT, для преемственных RG = R*RT/RB, но не менее 0.5 RT, и не более max{R, RT})"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentPositionsBalanced/r",
            "@type": "rdf:Property",
            "domain": "#TournamentPositionsBalanced",
            "label": "r",
            "range": "xsd:integer"
          },
          "title": "r",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "рейтинг команды"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentPositionsBalanced/bp",
            "@type": "rdf:Property",
            "domain": "#TournamentPositionsBalanced",
            "label": "bp",
            "range": "xsd:integer"
          },
          "title": "bp",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "прогнозный бонус BP команды"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentPositionsBalanced/d1",
            "@type": "rdf:Property",
            "domain": "#TournamentPositionsBalanced",
            "label": "d1",
            "range": "xsd:integer"
          },
          "title": "d1",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "балансная разность D1 = k(B-BP), где k – коэффициент учёта отрицательных разностей"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentPositionsBalanced/d2",
            "@type": "rdf:Property",
            "domain": "#TournamentPositionsBalanced",
            "label": "d2",
            "range": "xsd:integer"
          },
          "title": "d2",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "добавочный бонус D2 = 300*exp((B-2300)/350)"
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#TournamentPositionsBalanced/d",
            "@type": "rdf:Property",
            "domain": "#TournamentPositionsBalanced",
            "label": "d",
            "range": "xsd:integer"
          },
          "title": "d",
          "required": false,
          "readable": true,
          "writeable": true,
          "description": "результат турнира для команды, D = D1 + D2"
        }
      ],
      "supportedOperation": [
        {
          "@type": [
            "Operation",
            "schema:FindAction"
          ],
          "description": "Retrieves a TournamentPositionsBalanced resource.",
          "method": "GET",
          "returns": "owl:Nothing",
          "title": "getTournamentPositionsBalanced"
        }
      ],
      "description": "Информация о расчёте рейтинговых баллов по формуле Б"
    },
